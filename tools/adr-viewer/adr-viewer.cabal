cabal-version: 3.0
name: adr-viewer
version: 0.1.0.0
synopsis: Extract, check and render the plan-versus-build history of kyyn-v2's ADRs
license: NONE
copyright: All rights reserved
build-type: Simple
extra-source-files: template/viewer.html

common shared
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, aeson ==2.2.5.0, bytestring ==0.12.2.0,
    containers ==0.7, text ==2.1.3

library
  import: shared
  hs-source-dirs: src
  exposed-modules: AdrViewer.Types AdrViewer.Adr AdrViewer.Json AdrViewer.Git
    AdrViewer.Extract AdrViewer.Check AdrViewer.Model AdrViewer.Render AdrViewer.Template
  build-depends: aeson-pretty ==0.8.11, Diff ==1.0.2, directory ==1.3.8.5,
    filepath ==1.5.4.0, template-haskell ==2.22.0.0, typed-process ==0.2.13.0

executable adr-viewer
  import: shared
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: adr-viewer, optparse-applicative ==0.19.0.0, directory ==1.3.8.5,
    filepath ==1.5.4.0

test-suite adr-viewer-tests
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: AdrViewerTests.hs
  build-depends: adr-viewer, QuickCheck ==2.18.0.0
