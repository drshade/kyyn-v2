cabal-version: 3.0
name: kyyn-sdk
version: 0.1.0.0
license: NONE
copyright: All rights reserved.
build-type: Simple

library
  reexported-modules: Kyyn.Contract,
    Kyyn.Schema,
    Kyyn.Validation,
    Kyyn.Query,
    Kyyn.Evolution,
    Kyyn.Edit,
    Kyyn.Optics,
    Kyyn.Evolution.Proposal,
    Kyyn.Recipe,
    Kyyn.Plugin,
    Kyyn.Plugin.Host,
    Kyyn.Plugin.Sink
  default-language: Haskell2010
  build-depends: base >=4.22 && <4.23, kyyn-sdk:internal

library internal
  hs-source-dirs: src
  exposed-modules: Kyyn.Contract Kyyn.Schema Kyyn.Validation Kyyn.Query Kyyn.Evolution Kyyn.Edit Kyyn.Optics
    Kyyn.Evolution.Proposal Kyyn.Recipe
    Kyyn.Plugin Kyyn.Plugin.Host Kyyn.Plugin.Sink
     Kyyn.Contract.Scalars Kyyn.Contract.Wire Kyyn.Evolution.Stored Kyyn.Evolution.Target Kyyn.Evolution.Preparation Kyyn.Evolution.KnowledgeBase Kyyn.Edit.Internal Kyyn.Recipe.Edit Kyyn.Recipe.Evolution Kyyn.Recipe.Internal
  default-language: Haskell2010
  ghc-options: -Wall -Werror
  build-depends: base >=4.22 && <4.23, kyyn-types, agentic ==0.2.1.0, lens ==5.3.6, generic-lens >=2.3 && <2.4, agentic-aeson ==0.2.1.0, time, aeson >=2.2.4 && <2.3, transformers >=0.6.1 && <0.7, text, bytestring

library runtime
  visibility: public
  hs-source-dirs: ../kyyn-runtime/src
  exposed-modules: Kyyn.Runtime.Contract Kyyn.Runtime.Guest Kyyn.Runtime.Bindings
    Kyyn.Runtime.AgenticContract
    Kyyn.Runtime.Flow
    Kyyn.Runtime.Concurrent
    Kyyn.Runtime.Evolution
    Kyyn.Runtime.Snapshot
    Kyyn.Runtime.TargetEvolution
    Kyyn.Runtime.Json
    Kyyn.Runtime.Judgement
    Kyyn.Runtime.JudgementWire
    Kyyn.Runtime.Model
    Kyyn.Runtime.ModelWire
    Kyyn.Runtime.Plugin
    Kyyn.Runtime.PluginHost
    Kyyn.Runtime.PluginRegistration
    Kyyn.Runtime.Probability
    Kyyn.Runtime.Proposal
    Kyyn.Runtime.Query
    Kyyn.Runtime.Recipe
    Kyyn.Runtime.SchemaMetadata
    Kyyn.Runtime.Sink
    Kyyn.Runtime.ToolEntry
    Kyyn.Runtime.Transport
    Kyyn.Runtime.Validation
  other-modules: Kyyn.Runtime.Entry Kyyn.Runtime.AcquisitionEntry Kyyn.Runtime.PluginEntry Kyyn.Runtime.RecipeEntry
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: transformers, base >=4.22 && <4.23, kyyn-sdk:internal, kyyn-types,
    agentic ==0.2.1.0, agentic-aeson ==0.2.1.0, aeson >=2.2.4 && <2.3, text, bytestring

test-suite evolution-core
  type: exitcode-stdio-1.0
  main-is: EvolutionCore.hs
  hs-source-dirs: test
  other-modules: EditTests KnowledgeBaseTests RecipeTests RecipeEditTests
  default-language: Haskell2010
  ghc-options: -Wall -Werror -main-is EvolutionCore.main
  default-extensions: OverloadedStrings
  build-depends: kyyn-sdk:internal, agentic ==0.2.1.0, base >=4.22 && <4.23, kyyn-types, lens ==5.3.6, generic-lens >=2.3 && <2.4, aeson >=2.2.4 && <2.3, transformers >=0.6.1 && <0.7, text

test-suite wire-contracts
  type: exitcode-stdio-1.0
  main-is: ContractTests.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.22 && <4.23, kyyn-sdk, kyyn-types, kyyn-domain, agentic ==0.2.1.0, text, time, aeson >=2.2.4 && <2.3

test-suite guest-protocol
  type: exitcode-stdio-1.0
  main-is: GuestProtocolTests.hs
  hs-source-dirs: test ../../host/kyyn-plumbing/src
  other-modules: Kyyn.Plumbing.Protocol.Frame FlowObservationTests
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options: -Wall -Werror
  build-depends: agentic ==0.2.1.0, kyyn-domain, base >=4.22 && <4.23, kyyn-sdk, kyyn-sdk:runtime, kyyn-types,
    aeson >=2.2.4 && <2.3, bytestring, text, typed-process ==0.2.13.0, transformers

test-suite capabilities
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: CapabilityTests.hs
  other-modules: QueryCore
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.22 && <4.23, kyyn-sdk, kyyn-types

test-suite snapshot-preparation
  type: exitcode-stdio-1.0
  main-is: PreparationTests.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.22 && <4.23, kyyn-sdk:internal, kyyn-types, text, aeson >=2.2.4 && <2.3

test-suite target-evolution
  type: exitcode-stdio-1.0
  main-is: TargetEvolutionTests.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.22 && <4.23, kyyn-sdk:internal, kyyn-sdk:runtime, kyyn-types, text
