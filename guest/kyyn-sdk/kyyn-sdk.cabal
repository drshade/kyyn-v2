cabal-version: 3.0
name: kyyn-sdk
version: 0.1.0.0
license: NONE
copyright: All rights reserved.
build-type: Simple

library
  reexported-modules: Kyyn.Contract,
    Kyyn.Schema,
    Kyyn.Validation,
    Kyyn.Query,
    Kyyn.Evolution,
    Kyyn.Edit,
    Kyyn.Optics,
    Kyyn.Evolution.Proposal,
    Kyyn.Recipe,
    Kyyn.Plugin,
    Kyyn.Plugin.Host,
    Kyyn.Plugin.Sink
  default-language: Haskell2010
  build-depends: base >=4.20 && <4.21, kyyn-sdk:internal

library internal
  hs-source-dirs: src
  exposed-modules: Kyyn.Contract Kyyn.Schema Kyyn.Validation Kyyn.Query Kyyn.Evolution Kyyn.Edit Kyyn.Optics
    Kyyn.Evolution.Proposal Kyyn.Recipe
    Kyyn.Plugin Kyyn.Plugin.Host Kyyn.Plugin.Sink
     Kyyn.Contract.Scalars Kyyn.Evolution.Internal Kyyn.Evolution.KnowledgeBase Kyyn.Edit.Internal Kyyn.Recipe.Edit Kyyn.Recipe.Internal
  default-language: Haskell2010
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-types, agentic ==0.2.1.0, lens ==5.3.6, generic-lens ==2.2.2.0, time, json ==0.11, transformers ==0.6.1.1, text, bytestring

library runtime
  visibility: public
  hs-source-dirs: ../kyyn-runtime/src
  exposed-modules: Kyyn.Runtime.Contract Kyyn.Runtime.Guest
    Kyyn.Runtime.AgenticContract
    Kyyn.Runtime.Concurrent
    Kyyn.Runtime.Evolution
    Kyyn.Runtime.Json
    Kyyn.Runtime.Judgement
    Kyyn.Runtime.JudgementWire
    Kyyn.Runtime.Model
    Kyyn.Runtime.ModelWire
    Kyyn.Runtime.Plugin
    Kyyn.Runtime.PluginHost
    Kyyn.Runtime.PluginRegistration
    Kyyn.Runtime.Probability
    Kyyn.Runtime.Proposal
    Kyyn.Runtime.Query
    Kyyn.Runtime.Recipe
    Kyyn.Runtime.SchemaMetadata
    Kyyn.Runtime.Sink
    Kyyn.Runtime.Transport
    Kyyn.Runtime.Validation
  other-modules: Kyyn.Runtime.Entry Kyyn.Runtime.AcquisitionEntry
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-sdk:internal, kyyn-types,
    agentic ==0.2.1.0, agentic-aeson ==0.2.1.0, aeson ==2.2.5.0, json ==0.11, text, bytestring

test-suite evolution-core
  type: exitcode-stdio-1.0
  main-is: EvolutionCore.hs
  hs-source-dirs: test src
  other-modules: Kyyn.Evolution Kyyn.Evolution.Internal Kyyn.Evolution.KnowledgeBase
    Kyyn.Edit Kyyn.Edit.Internal Kyyn.Optics Kyyn.Recipe Kyyn.Evolution.Proposal
    Kyyn.Recipe.Edit Kyyn.Recipe.Internal EditTests KnowledgeBaseTests RecipeTests RecipeEditTests
  default-language: Haskell2010
  ghc-options: -Wall -Werror -main-is EvolutionCore.main
  default-extensions: OverloadedStrings
  build-depends: base >=4.20 && <4.21, kyyn-types, lens ==5.3.6, generic-lens ==2.2.2.0, json ==0.11, transformers ==0.6.1.1, text

test-suite wire-contracts
  type: exitcode-stdio-1.0
  main-is: ContractTests.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-sdk, kyyn-types, kyyn-domain, agentic ==0.2.1.0, text, time, aeson ==2.2.5.0

test-suite guest-protocol
  type: exitcode-stdio-1.0
  main-is: GuestProtocolTests.hs
  hs-source-dirs: test ../../host/kyyn-plumbing/src
  other-modules: Kyyn.Plumbing.Protocol.Frame
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options: -Wall -Werror
  build-depends: kyyn-domain, base >=4.20 && <4.21, kyyn-sdk, kyyn-sdk:runtime, kyyn-types,
    aeson ==2.2.5.0, bytestring, text, typed-process ==0.2.13.0, transformers

test-suite capabilities
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: CapabilityTests.hs
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-sdk, kyyn-types

test-suite plugin-contracts
  type: exitcode-stdio-1.0
  hs-source-dirs: test, ../../plugins/local-file/src, ../../plugins/github/src,
    ../../plugins/microsoft-graph/src, ../../plugins/salesforce/src
  main-is: PluginContractTests.hs
  other-modules: GitHub.Types
    LocalFile.Types
    MicrosoftGraph.Calendar.Types
    MicrosoftGraph.Directory.Types
    MicrosoftGraph.Files.Types
    MicrosoftGraph.Mail.Types
    MicrosoftGraph.Meetings.Types
    MicrosoftGraph.Types
    Salesforce.Query.Types
    Salesforce.Types
    LocalFile.Write
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-sdk, text
