cabal-version: 3.0
name: kyyn-domain
version: 0.1.0.0
license: NONE
copyright: All rights reserved for Kyyn-owned code; upstream notices remain applicable.
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules: Kyyn.Domain.DataType Kyyn.Domain.Failure Kyyn.Domain.Path Kyyn.Domain.Diagnostic
    Kyyn.Domain.Contract Kyyn.Domain.Root
    Kyyn.Domain.FileTree Kyyn.Domain.Git
  default-language: GHC2021
  default-extensions: NoFieldSelectors
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, deepseq, filepath, kyyn-types, bytestring,
    aeson ==2.2.5.0, cryptohash-sha256 ==0.11.102.1
