test-suite processes
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules: FileSystemTests
  default-language: GHC2021
  default-extensions: NoFieldSelectors
  ghc-options: -Wall -Werror -threaded
