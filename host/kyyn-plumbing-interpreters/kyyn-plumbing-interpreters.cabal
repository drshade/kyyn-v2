cabal-version: 3.0
name: kyyn-plumbing-interpreters
version: 0.1.0.0
license: NONE
copyright: All rights reserved for Kyyn-owned code; upstream notices remain applicable.
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules: Kyyn.Plumbing.Interpreter.Failure Kyyn.Plumbing.Interpreter.ProcessExecution
    Kyyn.Plumbing.Interpreter.FileSystem
  default-language: GHC2021
  default-extensions: NoFieldSelectors
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-domain, kyyn-plumbing,
    effectful-core ==2.6.1.0, bytestring, async, typed-process ==0.2.13.0,
    directory, filepath, temporary ==1.3

test-suite processes
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules: FileSystemTests
  default-language: GHC2021
  default-extensions: NoFieldSelectors
  ghc-options: -Wall -Werror -threaded
  build-depends: base >=4.20 && <4.21, kyyn-domain, kyyn-plumbing,
    kyyn-plumbing-interpreters, effectful-core ==2.6.1.0, bytestring, async,
    directory, unix, temporary ==1.3
