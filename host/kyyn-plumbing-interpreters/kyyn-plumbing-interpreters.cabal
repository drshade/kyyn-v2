cabal-version: 3.0
name: kyyn-plumbing-interpreters
version: 0.1.0.0
license: NONE
copyright: All rights reserved for Kyyn-owned code; upstream notices remain applicable.
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules: Kyyn.Plumbing.Interpreter.Failure Kyyn.Plumbing.Interpreter.ProcessExecution
    Kyyn.Plumbing.Interpreter.FileSystem
    Kyyn.Plumbing.Interpreter.FileAcquisition
    Kyyn.Plumbing.Interpreter.DhallHandling
    Kyyn.Plumbing.Interpreter.Git
    Kyyn.Plumbing.Interpreter.DocumentPersistence
    Kyyn.Plumbing.Interpreter.SecretStore
    Kyyn.Plumbing.Interpreter.HttpTransport
    Kyyn.Plumbing.Interpreter.PluginInteraction
    Kyyn.Plumbing.Interpreter.Judgement
    Kyyn.Plumbing.Interpreter.ModelTurn
  default-language: GHC2021
  default-extensions: NoFieldSelectors
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-domain, kyyn-plumbing,
    effectful-core ==2.6.1.0, bytestring, async, typed-process ==0.2.13.0,
    directory, filepath, temporary ==1.3, dhall ==1.42.3, aeson ==2.2.5.0, text,
    containers, prettyprinter, transformers, random ==1.3.1, time, filelock ==0.1.1.8,
    cryptohash-sha256 ==0.11.102.1, kyyn-types, agentic ==0.2.0.4, agentic-openai ==0.2.0.4, agentic-anthropic ==0.2.0.4, agentic-jev ==0.2.0.4,
    http-client ==0.7.19, http-client-tls ==0.3.6.4, http-types ==0.12.5, case-insensitive

test-suite plugin-host
  type: exitcode-stdio-1.0
  main-is: PluginHostTests.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Werror -threaded
  build-depends: base >=4.20 && <4.21, kyyn-plumbing, kyyn-plumbing-interpreters,
    effectful-core ==2.6.1.0, bytestring, text, http-client, async, network

test-suite model-turn-provider
  type: exitcode-stdio-1.0
  main-is: ModelTurnTests.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-domain, kyyn-plumbing, kyyn-plumbing-interpreters,
    effectful-core ==2.6.1.0, text, http-client, agentic, agentic-openai, agentic-anthropic

test-suite judgement-provider
  type: exitcode-stdio-1.0
  main-is: JudgementTests.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-domain, kyyn-types, kyyn-plumbing,
    kyyn-plumbing-interpreters, effectful-core ==2.6.1.0, text, aeson, http-client, agentic, agentic-jev

test-suite secret-store
  type: exitcode-stdio-1.0
  main-is: SecretTests.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Werror
