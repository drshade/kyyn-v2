cabal-version: 3.0
name: kyyn-plumbing-interpreters
version: 0.1.0.0
license: NONE
copyright: All rights reserved for Kyyn-owned code; upstream notices remain applicable.
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules: Kyyn.Plumbing.Interpreter.Failure Kyyn.Plumbing.Interpreter.ProcessExecution
    Kyyn.Plumbing.Interpreter.GuestExecution
    Kyyn.Plumbing.Interpreter.ApiInspection
    Kyyn.Plumbing.Interpreter.SchemaInspection
    Kyyn.Plumbing.Interpreter.GuestInspection
    Kyyn.Plumbing.Interpreter.GuestCompilation
    Kyyn.Plumbing.Interpreter.FileSystem
    Kyyn.Plumbing.Interpreter.FileAcquisition
    Kyyn.Plumbing.Interpreter.DhallHandling
    Kyyn.Plumbing.Interpreter.Git
    Kyyn.Plumbing.Interpreter.DocumentPersistence
    Kyyn.Plumbing.Interpreter.SecretStore
    Kyyn.Plumbing.Interpreter.HttpTransport
    Kyyn.Plumbing.Interpreter.BlobStorage
    Kyyn.Plumbing.Interpreter.ConcurrentExecution
    Kyyn.Plumbing.Interpreter.ContentDigest
    Kyyn.Plumbing.Interpreter.PluginInteraction
    Kyyn.Plumbing.Interpreter.Judgement
    Kyyn.Plumbing.Interpreter.ModelTurn
  default-language: GHC2021
  default-extensions: NoFieldSelectors
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-domain, kyyn-plumbing,
    effectful-core ==2.6.1.0, bytestring, async, typed-process ==0.2.13.0,
    directory, filepath, temporary ==1.3, dhall ==1.42.3, aeson ==2.2.5.0, text,
    containers, prettyprinter, transformers, random ==1.3.1, time, filelock ==0.1.1.8,
    cryptohash-sha256 ==0.11.102.1, kyyn-types, agentic ==0.2.1.0, agentic-openai ==0.2.1.0, agentic-anthropic ==0.2.1.0, agentic-jev ==0.2.1.0,
    http-client ==0.7.19, http-client-tls ==0.3.6.4, http-types ==0.12.5, case-insensitive

test-suite blob-storage
  type: exitcode-stdio-1.0
  main-is: BlobTests.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Werror -threaded
