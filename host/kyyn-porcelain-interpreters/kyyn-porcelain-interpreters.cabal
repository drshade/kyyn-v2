cabal-version: 3.0
name: kyyn-porcelain-interpreters
version: 0.1.0.0
license: NONE
copyright: All rights reserved.
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules: Kyyn.Porcelain.Interpreter.RootStore
    Kyyn.Porcelain.Interpreter.PluginInstallation
    Kyyn.Porcelain.Interpreter.KnowledgeBaseInitialization
    Kyyn.Porcelain.Interpreter.RootOpening
    Kyyn.Porcelain.Interpreter.GuestApi
    Kyyn.Porcelain.Interpreter.WorkspaceApi
    Kyyn.Porcelain.Interpreter.RootPublication
    Kyyn.Porcelain.Interpreter.WorkspaceStore
    Kyyn.Porcelain.Interpreter.EvolutionStore
    Kyyn.Porcelain.Interpreter.EvolutionAuthoring
    Kyyn.Porcelain.Interpreter.EvolutionExecution
    Kyyn.Porcelain.Interpreter.RootExecution
  default-language: GHC2021
  default-extensions: NoFieldSelectors OverloadedStrings
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-domain, kyyn-types, kyyn-porcelain, kyyn-plumbing,
    effectful-core ==2.6.1.0, aeson, bytestring, text, transformers, filepath

test-suite plugin-installation
  type: exitcode-stdio-1.0
  main-is: PluginInstallationTests.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-domain, kyyn-porcelain,
    kyyn-porcelain-interpreters, kyyn-plumbing, kyyn-plumbing-interpreters,
    effectful-core ==2.6.1.0, bytestring, directory, filepath, temporary ==1.3

test-suite guest-catalogue
  type: exitcode-stdio-1.0
  main-is: GuestApiTests.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-domain, kyyn-porcelain,
    kyyn-porcelain-interpreters, kyyn-plumbing, kyyn-plumbing-interpreters,
    effectful-core ==2.6.1.0, bytestring

test-suite evolution-reports
  type: exitcode-stdio-1.0
  main-is: EvolutionReportTests.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-domain, kyyn-types, kyyn-porcelain,
    kyyn-porcelain-interpreters, kyyn-plumbing-interpreters, effectful-core ==2.6.1.0,
    kyyn-plumbing, aeson, bytestring

test-suite roots
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules: GuestFixture ExecutionTests QueryExecutionTests ValidationTests RootExportTests WorkspaceTests EvolutionCaptureTests EvolutionExecutionTests CandidateTests AcceptanceHistoryTests PublicationTests InitializationTests WorkspaceApiTests
  hs-source-dirs: test
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-domain, kyyn-types, kyyn-porcelain,
    kyyn-porcelain-interpreters, kyyn-plumbing-interpreters, effectful-core ==2.6.1.0,
    kyyn-plumbing, aeson, bytestring, text, directory, filepath, temporary ==1.3
