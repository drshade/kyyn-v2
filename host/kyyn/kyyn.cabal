cabal-version: 3.0
name: kyyn
version: 0.1.0.0
license: NONE
copyright: All rights reserved.
build-type: Simple
extra-source-files: guide.md web/kyyn.js web/inspection.mjs web/run-viewer.mjs web/run-viewer.css

executable kyyn-v2
  hs-source-dirs: app src
  main-is: Main.hs
  other-modules: Kyyn.Configuration Kyyn.Composition Kyyn.Composition.Runtime Kyyn.Composition.Connectors
    Kyyn.Composition.Tools Kyyn.Composition.Queries Kyyn.Composition.Outputs Kyyn.Composition.RunViewing Kyyn.Web.Runs Kyyn.Composition.Runs Kyyn.Composition.Recipes Kyyn.Composition.Taps
    Kyyn.Composition.Secrets Kyyn.Composition.Timings Kyyn.Composition.SyncTimings Kyyn.Composition.Timing Kyyn.Composition.RootBrowsing
    Kyyn.Build Kyyn.Guide Kyyn.Web Kyyn.Composition.Web Kyyn.Web.Inspection Kyyn.Web.Assets Kyyn.Composition.Inspection
  default-language: GHC2021
  default-extensions: NoFieldSelectors OverloadedStrings
  ghc-options: -Wall -Werror -threaded -rtsopts
  build-depends: base >=4.22 && <4.23, kyyn-sdk, kyyn-domain, kyyn-types, kyyn-porcelain, kyyn-porcelain-interpreters,
    kyyn-plumbing, kyyn-plumbing-interpreters, kyyn-surfaces,
    effectful-core ==2.6.1.0, directory, filepath, time, transformers, aeson, bytestring, text,
    optparse-applicative >=0.18.1 && <0.20, template-haskell, wai, warp, http-types, network, mime-types, lucid, Diff, file-embed, containers

test-suite installed-journey
  type: exitcode-stdio-1.0
  main-is: Journey.hs
  hs-source-dirs: test
  default-language: GHC2021
  default-extensions: NoFieldSelectors OverloadedStrings
  ghc-options: -Wall -Werror
  build-depends: base >=4.22 && <4.23, kyyn-sdk, kyyn-domain, kyyn-types, kyyn-porcelain,
    kyyn-porcelain-interpreters, kyyn-plumbing-interpreters,
    effectful-core ==2.6.1.0, aeson, bytestring, text, directory, filepath,
    process, temporary ==1.3

test-suite sync-timings
  type: exitcode-stdio-1.0
  main-is: SyncTimingsTests.hs
  hs-source-dirs: test src
  other-modules: Kyyn.Composition.SyncTimings Kyyn.Composition.Timing
  default-language: GHC2021
  default-extensions: NoFieldSelectors OverloadedStrings
  ghc-options: -Wall -Werror
  build-depends: base >=4.22 && <4.23, kyyn-sdk, kyyn-domain, kyyn-types, kyyn-porcelain,
    kyyn-plumbing, kyyn-plumbing-interpreters, effectful-core ==2.6.1.0, text, bytestring, temporary ==1.3
