cabal-version: 3.0
name: kyyn-plumbing
version: 0.1.0.0
license: NONE
copyright: All rights reserved for Kyyn-owned code; upstream notices remain applicable.
build-type: Simple

library
  hs-source-dirs: src ../../guest/kyyn-runtime/src
  other-modules: Kyyn.Runtime.Json Kyyn.Runtime.ModelWire Kyyn.Runtime.JudgementWire
  exposed-modules: Kyyn.Plumbing.Capability.SchemaInspection.Codecs
    Kyyn.Plumbing.Capability.SchemaInspection.Agentic
    Kyyn.Plumbing.Capability.Failure Kyyn.Plumbing.Capability.ProcessExecution
    Kyyn.Plumbing.Capability.FileSystem Kyyn.Plumbing.Capability.GuestCompilation
    Kyyn.Plumbing.Capability.GuestExecution Kyyn.Plumbing.Capability.FileAcquisition
    Kyyn.Plumbing.Protocol.PluginMessages
    Kyyn.Plumbing.Capability.GuestCompilation.Types
    Kyyn.Plumbing.Protocol.Validation
    Kyyn.Plumbing.Protocol.Query
    Kyyn.Plumbing.Protocol.GuestApi
    Kyyn.Plumbing.Protocol.DataType
    Kyyn.Plumbing.Protocol.Inspection
    Kyyn.Plumbing.Protocol.Plugin
    Kyyn.Plumbing.Protocol.PluginInvocation
    Kyyn.Plumbing.Protocol.Tool
    Kyyn.Plumbing.Protocol.Recipe
    Kyyn.Plumbing.Protocol.PluginRegistration
    Kyyn.Plumbing.Protocol.ConnectorConfig
    Kyyn.Plumbing.Protocol.Evolution
    Kyyn.Plumbing.Protocol.FactEdits
    Kyyn.Plumbing.Protocol.FactProposal
    Kyyn.Plumbing.Protocol.Curation
    Kyyn.Plumbing.Protocol.Recipes
    Kyyn.Plumbing.Protocol.EvolutionRecord
    Kyyn.Plumbing.Protocol.EvolutionRecord.Document
    Kyyn.Plumbing.Protocol.EvolutionRecord.Contract
    Kyyn.Plumbing.Capability.SchemaInspection.Metadata
    Kyyn.Plumbing.Capability.SchemaInspection
    Kyyn.Plumbing.Capability.ApiInspection
    Kyyn.Plumbing.Capability.Git
    Kyyn.Plumbing.Capability.DhallHandling
    Kyyn.Plumbing.Capability.DocumentPersistence
    Kyyn.Plumbing.Capability.SecretStore
    Kyyn.Plumbing.Capability.HttpTransport
    Kyyn.Plumbing.Protocol.PluginHost
    Kyyn.Plumbing.Protocol.Tap
    Kyyn.Plumbing.Capability.PluginInteraction
    Kyyn.Plumbing.Capability.Judgement
    Kyyn.Plumbing.Capability.ModelTurn
    Kyyn.Plumbing.Protocol.Judgement
    Kyyn.Plumbing.Protocol.ModelConfiguration
    Kyyn.Plumbing.Protocol.ModelTurn
  default-language: GHC2021
  default-extensions: NoFieldSelectors OverloadedStrings
  ghc-options: -Wall -Werror
  build-depends: base >=4.20 && <4.21, kyyn-domain, bytestring, effectful-core ==2.6.1.0, transformers,
    cryptohash-sha256 ==0.11.102.1, text, filepath, kyyn-types, aeson ==2.2.5.0, agentic ==0.2.0.4, json ==0.11
