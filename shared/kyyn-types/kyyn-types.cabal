cabal-version: 3.0
name: kyyn-types
version: 0.1.0.0
license: NONE
copyright: All rights reserved for Kyyn-owned code.
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules: Kyyn.Types.Wire Kyyn.Types.Contract.ScalarKind Kyyn.Types.Guest Kyyn.Types.GuestBuild Kyyn.Types.Contract Kyyn.Types.SchemaMetadata Kyyn.Types.Fact Kyyn.Types.Diagnostic
    Kyyn.Types.Program Kyyn.Types.Query Kyyn.Types.StoredShape Kyyn.Types.SnapshotWire
    Kyyn.Types.Evidence Kyyn.Types.Evolution
    Kyyn.Types.Plugin Kyyn.Types.KnowledgeBase
    Kyyn.Types.PluginHost Kyyn.Types.Sink
    Kyyn.Types.Blob Kyyn.Types.Scalar
  other-modules: Kyyn.Types.Json
  default-language: Haskell2010
  ghc-options: -Wall -Werror
  build-depends: attoparsec, attoparsec-aeson, time, deepseq, agentic ==0.2.1.0, base >=4.22 && <4.23, text, bytestring, aeson >=2.2.4 && <2.3, cryptohash-sha256 ==0.11.102.1
