cabal-version: 3.0
name: kyyn-types
version: 0.1.0.0
license: NONE
copyright: All rights reserved for Kyyn-owned code.
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules: Kyyn.Types.Contract Kyyn.Types.SchemaMetadata Kyyn.Types.Fact Kyyn.Types.Diagnostic
    Kyyn.Types.Program Kyyn.Types.Query
    Kyyn.Types.Evidence Kyyn.Types.Evolution
    Kyyn.Types.Plugin Kyyn.Types.KnowledgeBase
    Kyyn.Types.PluginHost Kyyn.Types.Sink
    Kyyn.Types.Blob Kyyn.Types.Scalar
  default-language: Haskell2010
  ghc-options: -Wall -Werror
  build-depends: agentic ==0.2.1.0, base >=4.20 && <4.21, text, bytestring, aeson ==2.2.5.0, cryptohash-sha256 ==0.11.102.1
